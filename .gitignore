*.iml
.gradle/
/local.properties
.idea/
.DS_Store
/build
*/build
*/*/build
.cxx/
*/.cxx/
*/*/.cxx/
/captures
.externalNativeBuild

# tools/ are plain scripts; nothing here should be byte-compiled into the tree
__pycache__/
*.pyc

# Build outputs and profiler dumps never belong in the repo.
*.apk
*.aab
*.hprof

# Kotlin compiler session state: regenerated per build, and the .salive files are named
# after a content hash, so committing one adds a new file on every machine that builds.
/.kotlin/
