<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sync (milestone 5): Komga/Kavita live on the LAN. Cleartext stays per-host opt-in
         (SyncServer.allowCleartext); the per-host network security config is milestone 3's. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pre-release: no Drive backup history of reading state. Revisit with a
         dataExtractionRules allowlist before 1.0 if backup is wanted. -->
    <application
        android:name=".AbsolutexApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Absolutex.Splash">

        <!-- profileable lives in src/benchmark/AndroidManifest.xml: release builds must
             never be shell-profileable. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:colorMode="wideColorGamut"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.Absolutex.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open a book handed to us by a file manager or another app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- host="*" is required once this filter also carries pathPattern data tags
                     below: lint's AppLinkUrlError treats a path pattern with no host as broken,
                     even for a local file/content scheme that has no real authority segment. -->
                <data android:scheme="file" android:host="*" />
                <data android:scheme="content" android:host="*" />
                <!-- Types Absolutex actually opens (§5.1 file monitoring):
                     comic archives (CBZ/CBR), PDFs, and ZIP containers.
                     Each entry below is kept narrow so the app does not
                     declare itself as a handler for every MIME type on
                     the device (previous */* was too broad). -->
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/vnd.comicbook-rar" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/x-cbr" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <!-- Other archive types a comic arrives as: RAR and 7z by their own MIME types, the
                     x- types file managers register for CB7 and CBT, and tar. -->
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-cb7" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-cbt" />
                <data android:mimeType="application/x-tar" />
                <!-- Extension filters for SAF tree picks where MIME isn't set. -->
                <data android:pathPattern=".*\\.cbz" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.cbr" />
                <data android:pathPattern=".*\\.cb7" />
                <data android:pathPattern=".*\\.cbt" />
                <data android:pathPattern=".*\\.7z" />
                <data android:pathPattern=".*\\.tar" />
            </intent-filter>
        </activity>

        <!-- Continue Reading widget (receiver registration only; UI lives in :feature:widget). -->
        <receiver
            android:name="com.absolutex.feature.widget.ContinueReadingProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/continue_reading_info" />
        </receiver>
    </application>
</manifest>
