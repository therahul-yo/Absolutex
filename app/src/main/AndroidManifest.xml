<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pre-release: no Drive backup history of reading state. Revisit with a
         dataExtractionRules allowlist before 1.0 if backup is wanted. -->
    <application
        android:name=".AbsolutexApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Absolutex.Splash">

        <!-- profileable lives in src/benchmark/AndroidManifest.xml: release builds must
             never be shell-profileable. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:colorMode="wideColorGamut"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.Absolutex.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open a book handed to us by a file manager or another app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
