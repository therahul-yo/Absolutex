<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sync (milestone 5): Komga/Kavita live on the LAN. Cleartext stays per-host opt-in
         (SyncServer.allowCleartext); the per-host network security config is milestone 3's. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Pre-release: no Drive backup history of reading state. Revisit with a
         dataExtractionRules allowlist before 1.0 if backup is wanted. -->
    <application
        android:name=".AbsolutexApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Absolutex.Splash">

        <!-- profileable lives in src/benchmark/AndroidManifest.xml: release builds must
             never be shell-profileable. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:colorMode="wideColorGamut"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.Absolutex.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open a book handed to us by a file manager or another app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Continue Reading widget (receiver registration only; UI lives in :feature:widget). -->
        <receiver
            android:name="com.absolutex.feature.widget.ContinueReadingProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/continue_reading_info" />
        </receiver>
    </application>
</manifest>
