    <string name="onboarding_tagline">Every panel,\npin-sharp.</string>
    <string name="onboarding_welcome_body">A fast, minimal reader for comics, manga, PDFs and EPUBs. True black, and pages drawn on the GPU.</string>
    <string name="onboarding_folders_title">Where are your comics?</string>
    <string name="onboarding_folders_body">Pick a folder. Absolutex reads everything inside it and keeps up as you add more. Add as many as you like.</string>
