    </plurals>
    <string name="onboarding_reading_title">How do you read?</string>
    <string name="onboarding_reading_body">The direction pages turn. Each book can still read its own way.</string>
    <string name="onboarding_flow_ltr">Left to right</string>
    <string name="onboarding_flow_rtl">Manga</string>
    <string name="onboarding_flow_vertical">Vertical</string>
    <string name="onboarding_flow_ltr_hint">Pages turn to the left, like most comics.</string>
    <string name="onboarding_flow_rtl_hint">Right to left, the way manga is printed.</string>
    <string name="onboarding_flow_vertical_hint">One long scroll, for webtoons.</string>
    <string name="onboarding_true_black">True black</string>
    <string name="onboarding_true_black_body">Pure black backgrounds. On an OLED screen the pixels switch off.</string>
    <string name="onboarding_choices_title">A few choices</string>
    <string name="onboarding_choices_body">All of this lives in Settings too, so nothing here is final.</string>
    <string name="onboarding_covers">Show document covers</string>
    <string name="onboarding_covers_body">A PDF\'s first page as its cover. Off keeps private documents off your shelf.</string>
    <string name="onboarding_image_folders">Folders of images as books</string>
    <string name="onboarding_image_folders_body">For comics kept as loose image files. Off keeps photo folders out.</string>
