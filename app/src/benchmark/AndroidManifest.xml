<?xml version="1.0" encoding="utf-8"?>
<!--
  Benchmark-variant-only manifest. The benchmark build type is initWith(release) and
  therefore not debuggable, so StartupTimingMetric has no way to read the app's trace
  unless the app is explicitly profileable by shell.

  This is done as a source-set manifest rather than `isProfileable = true` on the build
  type so that the release APK cannot pick it up by accident: manifest merging scopes it
  to the benchmark variant and nothing else.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <profileable android:shell="true" />
    </application>
</manifest>
