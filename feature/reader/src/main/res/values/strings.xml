<?xml version="1.0" encoding="utf-8"?>
<!-- Generic reader errors: raw Uris and archive entry names must never reach the UI
     (they leak provider paths) — detail goes to logcat only. -->
<resources>
    <string name="reader_open_failed">Couldn’t open this book</string>
    <string name="reader_page_unreadable">This page couldn’t be read</string>
    <string name="reader_no_pages">No readable pages</string>
    <string name="reader_retry">Retry</string>
    <string name="reader_recovery_known">%1$d of %2$d pages readable</string>
    <string name="reader_recovery_unknown">%1$d pages readable (total unknown)</string>

    <!-- Reader chrome. The indicator is 1-based: page 1 of 45, not 0 of 44. -->
    <string name="reader_page_indicator">%1$d / %2$d</string>
    <string name="reader_page_indicator_desc">Page %1$d of %2$d</string>
    <!-- Same page, when it is bookmarked. A separate sentence rather than the one above
         plus ", bookmarked", so a translation can put the state where its language
         wants it instead of always last. -->
    <string name="reader_page_indicator_desc_bookmarked">Page %1$d of %2$d, bookmarked</string>
